# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Your Cerebras Cloud API key.
CEREBRAS_API_KEY=

# Any model your Cerebras account has access to (e.g. gpt-oss-120b, gemma-4-31b, zai-glm-4.7).
CEREBRAS_MODEL=gpt-oss-120b

# Comma-separated list of origins allowed to call the API. "*" is fine for a
# hackathon demo; lock this down to your real frontend origin in production.
ALLOWED_ORIGINS=*
